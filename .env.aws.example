# ============================================================
# Red Velvet — Variables para el despliegue en AWS.
# Copia este archivo a .env.aws y completa los valores.
#   cp .env.aws.example .env.aws
# Luego usa el wrapper:  ./deploy-aws.sh up -d --build
# ============================================================

# Dominio público (debe coincidir con RV_DOMAIN en Dotaciones Dony).
RV_DOMAIN=redvelvet.duckdns.org

# --- Base de datos (contenedor PostgreSQL dentro de la EC2) ---
DB_NAME=red_velvet
DB_USER=redvelvet
DB_PASSWORD=CAMBIA_ESTA_CONTRASENA_FUERTE
DB_SSL=false

# --- JWT: usa cadenas largas y aleatorias ---
# Genera una con:  openssl rand -hex 32
JWT_SECRET=CAMBIA_ESTE_SECRETO_LARGO
JWT_REFRESH_SECRET=CAMBIA_ESTE_REFRESH_SECRETO_LARGO
